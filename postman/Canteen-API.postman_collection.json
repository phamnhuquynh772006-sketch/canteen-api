            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"201 Created\", () => {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst item = pm.response.json();\r\n\r\npm.test(\"Có header Location đúng\", () => {\r\n    pm.expect(pm.response.headers.get(\"Location\"))\r\n        .to.eql(\"/menu-items/\" + item.id);\r\n});\r\n\r\npm.test(\"Mặc định available = true\", () => {\r\n    pm.expect(item.available).to.be.true;\r\n});\r\n\r\npm.collectionVariables.set(\"itemId\", item.id);\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
