          "name": "TC03 - Filter bun pho",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"200 OK\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst items = pm.response.json();\r\n\r\npm.test(\"Chỉ có món bun_pho\", () => {\r\n    items.forEach(i => {\r\n        pm.expect(i.category).to.eql(\"bun_pho\");\r\n    });\r\n});\r\n\r\npm.test(\"Giá giảm dần\", () => {\r\n    for (let k = 1; k < items.length; k++) {\r\n        pm.expect(items[k - 1].price)\r\n            .to.be.at.least(items[k].price);\r\n    }\r\n});\r\n"
                ]
              }
            }
          ],
